    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, setDoc, getDoc, addDoc, updateDoc, deleteDoc, onSnapshot, collection } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Global App State
        let db = null;
        let auth = null;
        let currentUser = null;
        let cases = [];
        let supervisorPin = "1234";
        let isSupervisorMode = false;
        let currentImages = { preXray: null, preClin: null, intraOp: null, postOp: null };
        let caseToDeleteId = null;

        const appId = typeof __app_id !== 'undefined' ? __app_id : 'omfs-shared-logbook';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : null;

        // Update Sync Status Badge
        function setSyncStatus(connected, label) {
            const badge = document.getElementById('sync-badge');
            if (connected) {
                badge.className = "inline-flex items-center gap-1.5 text-[11px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2.5 py-0.5 rounded-full";
                badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-400"></span>${label}`;
            } else {
                badge.className = "inline-flex items-center gap-1.5 text-[11px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30 px-2.5 py-0.5 rounded-full";
                badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>${label}`;
            }
        }

        // Generate clean vector sample images for first-time initialization
        function createSampleMedicalGraphic(type, title, subtitle) {
            const canvas = document.createElement('canvas');
            canvas.width = 500;
            canvas.height = 330;
            const ctx = canvas.getContext('2d');

            if (type === 'xray' || type === 'postxray') {
                ctx.fillStyle = '#0f172a';
                ctx.fillRect(0, 0, 500, 330);
                ctx.strokeStyle = '#94a3b8';
                ctx.lineWidth = 8;
                ctx.beginPath();
                ctx.moveTo(85, 100);
                ctx.lineTo(120, 225);
                ctx.quadraticCurveTo(250, 265, 380, 225);
                ctx.lineTo(415, 100);
                ctx.stroke();

                if (type === 'xray') {
                    ctx.strokeStyle = '#ef4444';
                    ctx.lineWidth = 4;
                    ctx.setLineDash([7, 5]);
                    ctx.beginPath();
                    ctx.moveTo(360, 180);
                    ctx.lineTo(395, 235);
                    ctx.stroke();
                    ctx.setLineDash([]);
                } else {
                    ctx.strokeStyle = '#10b981';
                    ctx.lineWidth = 5;
                    ctx.beginPath();
                    ctx.moveTo(350, 198);
                    ctx.lineTo(402, 186);
                    ctx.stroke();
                }
            } else {
                ctx.fillStyle = '#0c4a6e';
                ctx.fillRect(0, 0, 500, 330);
                ctx.strokeStyle = 'rgba(255,255,255,0.18)';
                ctx.lineWidth = 2;
                ctx.strokeRect(16, 16, 468, 298);
            }

            ctx.fillStyle = '#f8fafc';
            ctx.font = 'bold 20px Cairo, sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText(title, 250, 68);

            ctx.fillStyle = '#cbd5e1';
            ctx.font = '14px Cairo, sans-serif';
            ctx.fillText(subtitle, 250, 292);

            return canvas.toDataURL('image/jpeg', 0.75);
        }

        // Initialize Firebase Authentication & Real-Time Firestore Listeners
        async function initCloudApp() {
            document.getElementById('print-date').textContent = 'تاريخ التقرير: ' + new Date().toLocaleDateString('ar-EG');

            if (!firebaseConfig) {
                setSyncStatus(false, "وضع المعاينة غير متصل بالسحابة");
                document.getElementById('loading-state').classList.add('hidden');
                renderCases();
                return;
            }

            try {
                const app = initializeApp(firebaseConfig);
                auth = getAuth(app);
                db = getFirestore(app);

                // RULE 3: Authenticate FIRST before any Firestore query
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }

                onAuthStateChanged(auth, async (user) => {
                    if (!user) return;
                    currentUser = user;
                    setSyncStatus(true, "متصل سحابياً ومباشر");
                    await setupRealtimeListeners();
                });
            } catch (err) {
                console.error("Cloud Init Error:", err);
                setSyncStatus(false, "تعذر الاتصال بالسحابة");
                document.getElementById('loading-state').classList.add('hidden');
            }
        }

        // Setup Public Shared Collection Listeners (RULE 1 & RULE 2)
        async function setupRealtimeListeners() {
            if (!currentUser || !db) return;

            // 1. Listen to Shared Supervisor Settings (PIN)
            const settingsDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'omfs_settings', 'config');
            onSnapshot(settingsDocRef, (snap) => {
                if (snap.exists() && snap.data().supervisorPin) {
                    supervisorPin = String(snap.data().supervisorPin);
                }
            }, (err) => console.error("Settings listener error:", err));

            // 2. Listen to All Shared Surgical Cases
            const casesColRef = collection(db, 'artifacts', appId, 'public', 'data', 'omfs_cases');
            onSnapshot(casesColRef, async (snapshot) => {
                document.getElementById('loading-state').classList.add('hidden');
                const loadedCases = [];
                snapshot.forEach((docSnap) => {
                    loadedCases.push({ id: docSnap.id, ...docSnap.data() });
                });

                // Sort newest first in memory (RULE 2: No orderBy in Firestore query)
                loadedCases.sort((a, b) => {
                    const tA = a.createdAt || 0;
                    const tB = b.createdAt || 0;
                    return tB - tA;
                });

                // Seed 1 sample case if database is completely empty on first launch
                if (loadedCases.length === 0 && !sessionStorage.getItem('seeded_omfs')) {
                    sessionStorage.setItem('seeded_omfs', 'true');
                    await addDoc(casesColRef, {
                        residentName: 'د. سارة العبدالله',
                        supervisor: 'أ.د. خالد المنصور',
                        role: 'Primary Surgeon',
                        date: new Date().toISOString().split('T')[0],
                        patientCode: 'محمد ع. (MRN-1042)',
                        age: '27',
                        gender: 'ذكر',
                        asa: 'ASA I',
                        category: 'Maxillofacial Trauma',
                        diagnosis: 'Left Mandibular Angle Fracture',
                        procedure: 'ORIF via Intraoral Approach using 2.0mm Champy Miniplate',
                        anesthesia: 'GA (تخدير عام)',
                        notes: 'استخراج الرحى الثالثة المنطمرة في خط الكسر #38، رد تشريحي وتثبيت بصفيحة تيتانيوم 4 ثقوب. الإطباق سليم والعصب السنخي السفلي محفوظ.',
