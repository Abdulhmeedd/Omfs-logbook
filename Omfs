<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>سجل الحالات الجراحية التشاركي | Collaborative OMFS Logbook</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Cairo -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Cairo', 'sans-serif'],
                    },
                    colors: {
                        medical: {
                            950: '#081226',
                            900: '#0f172a',
                            800: '#1e293b',
                            blue: '#0284c7',
                            blueDark: '#0369a1',
                            teal: '#0d9488',
                            tealDark: '#0f766e',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f1f5f9;
            color: #0f172a;
            -webkit-tap-highlight-color: transparent;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #e2e8f0;
        }
        ::-webkit-scrollbar-thumb {
            background: #94a3b8;
            border-radius: 3px;
        }

        /* Print Media Styles for A4 Academic Portfolio */
        @media print {
            body {
                background-color: #ffffff !important;
                color: #000000 !important;
                font-size: 11pt;
            }
            .no-print {
                display: none !important;
            }
            .print-only {
                display: block !important;
            }
            .print-card {
                box-shadow: none !important;
                border: 1px solid #cbd5e1 !important;
                break-inside: avoid;
                margin-bottom: 1.25rem;
            }
            .print-grid-images {
                display: grid !important;
                grid-template-columns: repeat(4, 1fr) !important;
                gap: 8px !important;
            }
            .print-grid-images img {
                height: 105px !important;
                object-fit: cover !important;
                border: 1px solid #94a3b8;
            }
            @page {
                size: A4 portrait;
                margin: 10mm;
            }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed bottom-5 left-5 z-50 flex flex-col gap-2 no-print"></div>

    <!-- Top Navigation Header (Tablet-Optimized Touch Targets) -->
    <header class="bg-medical-900 text-white shadow-lg sticky top-0 z-30 no-print">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3.5 flex flex-wrap items-center justify-between gap-3">
            <!-- Brand & Live Sync Indicator -->
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-medical-teal to-medical-blue flex items-center justify-center text-white shadow-md">
                    <i class="fa-solid fa-staff-snake text-xl"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <h1 class="text-base sm:text-xl font-extrabold tracking-tight">سجل الحالات الجراحية التشاركي</h1>
                        <span id="sync-badge" class="inline-flex items-center gap-1.5 text-[11px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30 px-2.5 py-0.5 rounded-full">
                            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                            جاري الاتصال...
                        </span>
                    </div>
                    <p class="text-xs text-slate-400 hidden sm:block">قسم جراحة الوجه والفكين | منصة المتابعة السحابية للمقيمين والمشرفين</p>
                </div>
            </div>

            <!-- Primary Touch Actions -->
            <div class="flex flex-wrap items-center gap-2.5">
                <button onclick="openCaseModal()" class="bg-medical-teal hover:bg-medical-tealDark active:scale-95 text-white font-bold px-4 py-2.5 rounded-xl text-sm transition shadow-md flex items-center gap-2">
                    <i class="fa-solid fa-plus-circle text-base"></i>
                    <span>إضافة حالة جراحية</span>
                </button>

                <button id="supervisor-mode-btn" onclick="openSupervisorLoginModal()" class="bg-slate-800 hover:bg-slate-700 active:scale-95 text-slate-200 border border-slate-700 font-bold px-4 py-2.5 rounded-xl text-sm transition flex items-center gap-2">
                    <i class="fa-solid fa-user-shield text-amber-400"></i>
                    <span id="supervisor-btn-text">دخول المشرف</span>
                </button>

                <button onclick="window.print()" class="bg-slate-800 hover:bg-slate-700 active:scale-95 text-slate-200 border border-slate-700 font-semibold px-3.5 py-2.5 rounded-xl text-sm transition flex items-center gap-2" title="طباعة التقرير A4">
                    <i class="fa-solid fa-print text-sky-400"></i>
                    <span class="hidden md:inline">طباعة / PDF</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Print-Only Official Header -->
    <div class="hidden print-only border-b-2 border-slate-900 pb-4 mb-5">
        <div class="flex justify-between items-center">
            <div>
                <h1 class="text-2xl font-extrabold text-slate-900">السجل الجراحي الموحد لقسم جراحة الوجه والفكين</h1>
                <p class="text-sm text-slate-600">Department of Oral & Maxillofacial Surgery — Collaborative Logbook</p>
            </div>
            <div class="text-left text-xs text-slate-700">
                <p id="print-date" class="font-semibold"></p>
                <p id="print-summary-line" class="font-bold mt-1"></p>
            </div>
        </div>
    </div>

    <!-- Main Content Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-5">

        <!-- Supervisor Active Banner (Shown when Supervisor PIN is unlocked) -->
        <div id="supervisor-banner" class="hidden mb-5 bg-emerald-900 text-white rounded-2xl p-4 shadow-md flex flex-wrap items-center justify-between gap-3 no-print">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-emerald-700 flex items-center justify-center text-emerald-200 text-lg">
                    <i class="fa-solid fa-award"></i>
                </div>
                <div>
                    <h2 class="text-sm sm:text-base font-bold flex items-center gap-2">
                        وضع الطبيب المشرف مفعّل (Supervisor Mode)
                        <span class="text-[11px] bg-emerald-700 px-2 py-0.5 rounded-full text-emerald-100">صلاحية الاعتماد والتقييم</span>
                    </h2>
                    <p class="text-xs text-emerald-200">يمكنك الآن اعتماد الحالات، كتابة الملاحظات التقييمية للمقيمين، أو تغيير رمز المرور.</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button onclick="openChangePinModal()" class="bg-emerald-800 hover:bg-emerald-700 text-white text-xs font-semibold px-3.5 py-2 rounded-xl border border-emerald-600 transition">
                    <i class="fa-solid fa-key ml-1"></i> تغيير رمز المرور
                </button>
                <button onclick="logoutSupervisor()" class="bg-white/10 hover:bg-white/20 text-white text-xs font-semibold px-3.5 py-2 rounded-xl transition">
                    <i class="fa-solid fa-lock ml-1"></i> قفل وضع المشرف
                </button>
            </div>
        </div>

        <!-- 4 Top Dashboard KPIs -->
        <section class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-5 no-print">
            <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold text-slate-500">إجمالي الحالات</p>
                    <p id="stat-total" class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">0</p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-700 flex items-center justify-center text-xl">
                    <i class="fa-solid fa-folder-tree"></i>
                </div>
            </div>

            <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold text-slate-500">الحالات المعتمدة</p>
                    <p id="stat-approved" class="text-2xl sm:text-3xl font-extrabold text-emerald-600 mt-1">0</p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
            </div>

            <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold text-slate-500">قيد المراجعة</p>
                    <p id="stat-pending" class="text-2xl sm:text-3xl font-extrabold text-amber-600 mt-1">0</p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl">
                    <i class="fa-solid fa-hourglass-half"></i>
                </div>
            </div>

            <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold text-slate-500">الأطباء المشاركون</p>
                    <p id="stat-doctors" class="text-2xl sm:text-3xl font-extrabold text-medical-blue mt-1">0</p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-sky-50 text-medical-blue flex items-center justify-center text-xl">
                    <i class="fa-solid fa-user-doctor"></i>
                </div>
            </div>
        </section>

        <!-- Search & Tablet-Friendly Filters Bar -->
        <section class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm mb-5 no-print">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 items-center">
                <!-- Search Input -->
                <div class="lg:col-span-4 relative">
                    <i class="fa-solid fa-magnifying-glass absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="text" id="search-input" oninput="renderCases()" placeholder="بحث بالتشخيص، الإجراء، المريض..." class="w-full pr-10 pl-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-medical-blue focus:bg-white transition">
                </div>

                <!-- Resident Filter -->
                <div class="lg:col-span-3">
                    <select id="filter-resident" onchange="renderCases()" class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-medical-blue">
                        <option value="ALL">جميع الأطباء المقيمين</option>
                    </select>
                </div>

                <!-- Category Filter -->
                <div class="lg:col-span-3">
                    <select id="filter-category" onchange="renderCases()" class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-medical-blue">
                        <option value="ALL">جميع التصنيفات الجراحية</option>
                        <option value="Maxillofacial Trauma">رضوض وكسور الوجه (Trauma)</option>
                        <option value="Dentoalveolar & Impactions">جراحة سنخية وطمر (Dentoalveolar)</option>
                        <option value="Cysts, Tumors & Pathology">أكياس وأورام (Pathology)</option>
                        <option value="Implantology & Grafting">زراعة وتطعيم عظم (Implantology)</option>
                        <option value="Odontogenic Infections">التهابات الوجه والرقبة (Infections)</option>
                        <option value="Orthognathic & TMJ">جراحة تقويمية ومفصل (Orthognathic/TMJ)</option>
                        <option value="Other">أخرى (Other)</option>
                    </select>
                </div>

                <!-- Approval Status Filter -->
                <div class="lg:col-span-2">
                    <select id="filter-status" onchange="renderCases()" class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-medical-blue">
                        <option value="ALL">كل الحالات</option>
                        <option value="approved">المعتمدة فقط ✓</option>
                        <option value="pending">قيد المراجعة ⏳</option>
                    </select>
                </div>
            </div>
        </section>

        <!-- Loading Skeleton -->
        <div id="loading-state" class="bg-white rounded-2xl border border-slate-200 p-10 text-center">
            <i class="fa-solid fa-circle-notch fa-spin text-3xl text-medical-blue mb-3"></i>
            <p class="text-sm font-bold text-slate-700">جاري مزامنة السجل السحابي للقسم...</p>
        </div>

        <!-- Cases Feed -->
        <section id="cases-container" class="space-y-4 hidden"></section>

        <!-- Empty State -->
        <div id="empty-state" class="hidden bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center">
            <div class="w-16 h-16 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center text-2xl mx-auto mb-3">
                <i class="fa-solid fa-notes-medical"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-800">لا توجد حالات جراحية مطابقة</h3>
            <p class="text-sm text-slate-500 mt-1 max-w-md mx-auto">يمكن للأطباء المقيمين إضافة حالاتهم الآن لتظهر مباشرة في لوحة متابعة المشرف.</p>
            <button onclick="openCaseModal()" class="mt-5 bg-medical-teal hover:bg-medical-tealDark text-white font-bold px-6 py-3 rounded-xl text-sm transition inline-flex items-center gap-2 shadow-sm">
                <i class="fa-solid fa-plus"></i>
                إضافة أول حالة جراحية
            </button>
        </div>

    </main>

    <!-- ===================================================================== -->
    <!-- MODAL 1: ADD / EDIT SURGICAL CASE FORM                                -->
    <!-- ===================================================================== -->
    <div id="case-modal" class="hidden fixed inset-0 z-50 bg-slate-950/75 backdrop-blur-sm overflow-y-auto no-print">
        <div class="min-h-screen px-3 py-5 flex items-center justify-center">
            <div class="bg-white w-full max-w-4xl rounded-2xl shadow-2xl border border-slate-200 overflow-hidden">
                
                <div class="bg-medical-900 text-white px-6 py-4 flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <i class="fa-solid fa-file-medical text-teal-400 text-xl"></i>
                        <h2 id="modal-title" class="text-lg font-bold">إضافة حالة جراحية للسجل المشترك</h2>
                    </div>
                    <button onclick="closeCaseModal()" class="text-slate-400 hover:text-white p-2 rounded-xl transition">
                        <i class="fa-solid fa-xmark text-xl"></i>
                    </button>
                </div>

                <form id="case-form" onsubmit="saveCase(event)" class="p-5 sm:p-6 space-y-5 max-h-[84vh] overflow-y-auto">
                    <input type="hidden" id="edit-case-id">

                    <!-- Section 1: Resident & Supervisor Attribution -->
                    <div class="bg-sky-50/70 p-4 rounded-2xl border border-sky-200/80">
                        <h3 class="text-sm font-extrabold text-medical-900 mb-3 flex items-center gap-2">
                            <span class="w-6 h-6 rounded-full bg-medical-blue text-white text-xs flex items-center justify-center">1</span>
                            بيانات الطبيب المقيم والفريق الجراحي
                        </h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">اسم الطبيب المقيم (Resident) *</label>
                                <input type="text" id="f-residentName" required placeholder="د. اسم المقيم" class="w-full px-3 py-2.5 bg-white border border-slate-300 rounded-xl text-sm font-semibold focus:ring-2 focus:ring-medical-blue focus:outline-none">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">الطبيب المشرف (Supervisor) *</label>
                                <input type="text" id="f-supervisor" required placeholder="أ.د. / د. اسم المشرف" class="w-full px-3 py-2.5 bg-white border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-medical-blue focus:outline-none">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">الدور الجراحي (Role) *</label>
                                <select id="f-role" required class="w-full px-3 py-2.5 bg-white border border-slate-300 rounded-xl text-sm font-bold text-medical-tealDark focus:ring-2 focus:ring-medical-blue focus:outline-none">
                                    <option value="Primary Surgeon">جراح رئيسي (Primary Surgeon)</option>
                                    <option value="First Assistant">مساعد أول (First Assistant)</option>
                                    <option value="Observer">مراقب (Observer)</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">تاريخ العملية *</label>
                                <input type="date" id="f-date" required class="w-full px-3 py-2.5 bg-white border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-medical-blue focus:outline-none">
                            </div>
                        </div>
                    </div>

                    <!-- Section 2: Patient Info & ASA -->
                    <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200">
                        <h3 class="text-sm font-extrabold text-medical-900 mb-3 flex items-center gap-2">
                            <span class="w-6 h-6 rounded-full bg-medical-blue text-white text-xs flex items-center justify-center">2</span>
                            بيانات المريض والتقييم الصحي (Patient & ASA)
                        </h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                            <div class="sm:col-span-2">
                                <label class="block text-xs font-bold text-slate-700 mb-1">اسم المريض أو رمزه (Patient Name / ID) *</label>
                                <input type="text" id="f-patientCode" required placeholder="مثال: أحمد م. / MRN-4021" class="w-full px-3 py-2.5 bg-white border border-slate-300 rounded-xl text-sm font-semibold focus:ring-2 focus:ring-medical-blue focus:outline-none">
                            </div>
                            <div class="grid grid-cols-2 gap-2">
                                <div>
                                    <label class="block text-xs font-bold text-slate-700 mb-1">العمر *</label>
                                    <input type="number" id="f-age" required min="0" max="120" placeholder="سنة" class="w-full px-3 py-2.5 bg-white border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-medical-blue focus:outline-none">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-700 mb-1">الجنس</label>
                                    <select id="f-gender" class="w-full px-2 py-2.5 bg-white border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-medical-blue focus:outline-none">
                                        <option value="ذكر">ذكر (M)</option>
                                        <option value="أنثى">أنثى (F)</option>
                                    </select>
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">تصنيف ASA الصحي</label>
                                <select id="f-asa" class="w-full px-3 py-2.5 bg-white border border-slate-300 rounded-xl text-sm font-semibold focus:ring-2 focus:ring-medical-blue focus:outline-none">
                                    <option value="ASA I">ASA I (سليم)</option>
                                    <option value="ASA II">ASA II (مرض جهازي خفيف)</option>
                                    <option value="ASA III">ASA III (مرض جهازي شديد)</option>
                                    <option value="ASA IV">ASA IV (مهدد للحياة)</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Section 3: Diagnosis & Surgical Procedure -->
                    <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200">
                        <h3 class="text-sm font-extrabold text-medical-900 mb-3 flex items-center gap-2">
                            <span class="w-6 h-6 rounded-full bg-medical-blue text-white text-xs flex items-center justify-center">3</span>
                            التشخيص والتدخل الجراحي (Diagnosis & Procedure)
                        </h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">التصنيف الجراحي *</label>
                                <select id="f-category" required class="w-full px-3 py-2.5 bg-white border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-medical-blue focus:outline-none">
                                    <option value="Maxillofacial Trauma">رضوض وكسور الوجه (Trauma)</option>
                                    <option value="Dentoalveolar & Impactions">جراحة سنخية وطمر (Dentoalveolar)</option>
                                    <option value="Cysts, Tumors & Pathology">أكياس وأورام (Pathology)</option>
                                    <option value="Implantology & Grafting">زراعة وتطعيم عظم (Implantology)</option>
                                    <option value="Odontogenic Infections">التهابات الوجه والرقبة (Infections)</option>
                                    <option value="Orthognathic & TMJ">جراحة تقويمية ومفصل (Orthognathic/TMJ)</option>
                                    <option value="Other">أخرى (Other)</option>
                                </select>
                            </div>
                            <div class="sm:col-span-2">
                                <label class="block text-xs font-bold text-slate-700 mb-1">التشخيص النهائي (Diagnosis) *</label>
                                <input type="text" id="f-diagnosis" required placeholder="مثال: Left Mandibular Angle Fracture" class="w-full px-3 py-2.5 bg-white border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-medical-blue focus:outline-none">
                            </div>

                            <div class="sm:col-span-2">
                                <label class="block text-xs font-bold text-slate-700 mb-1">الإجراء الجراحي (Surgical Procedure) *</label>
                                <input type="text" id="f-procedure" required placeholder="مثال: ORIF via Intraoral Approach using 2.0mm Titanium Miniplate" class="w-full px-3 py-2.5 bg-white border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-medical-blue focus:outline-none">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">نوع التخدير (Anesthesia)</label>
                                <select id="f-anesthesia" class="w-full px-3 py-2.5 bg-white border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-medical-blue focus:outline-none">
                                    <option value="GA (تخدير عام)">GA (تخدير عام)</option>
