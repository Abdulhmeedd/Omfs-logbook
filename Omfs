            try {
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'omfs_cases', caseId);
                await updateDoc(docRef, {
                    status: newStatus,
                    supervisorFeedback: feedback,
                    reviewedAt: Date.now()
                });
                closeFeedbackModal();
                showToast("تم حفظ تقييم واعتماد المشرف بنجاح");
            } catch (err) {
                console.error("Review error:", err);
                showToast("حدث خطأ أثناء حفظ التقييم", "error");
            }
        };

        // Delete Case
        window.promptDeleteCase = function(id) {
            caseToDeleteId = id;
            document.getElementById('delete-modal').classList.remove('hidden');
            document.getElementById('confirm-delete-btn').onclick = async function() {
                if (!currentUser || !db || !caseToDeleteId) return;
                try {
                    const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'omfs_cases', caseToDeleteId);
                    await deleteDoc(docRef);
                    closeDeleteModal();
                    showToast("تم حذف الحالة من السجل المشترك");
                } catch (err) {
                    console.error("Delete error:", err);
                    showToast("تعذر حذف الحالة", "error");
                }
            };
        };

        window.closeDeleteModal = function() {
            document.getElementById('delete-modal').classList.add('hidden');
            caseToDeleteId = null;
        };

        // Lightbox Preview
        window.openLightbox = function(caseId, slot, caption) {
            const target = cases.find(c => c.id === caseId);
            if (!target || !target.images || !target.images[slot]) return;

            document.getElementById('lightbox-img').src = target.images[slot];
            document.getElementById('lightbox-caption').textContent = `${target.residentName} | ${target.patientCode} — ${caption}`;
            document.getElementById('lightbox-modal').classList.remove('hidden');
        };

        window.closeLightbox = function() {
            document.getElementById('lightbox-modal').classList.add('hidden');
        };

        // Toast Helper
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const bgColor = type === 'error' ? 'bg-red-600' : 'bg-medical-900';
            const icon = type === 'error' ? 'fa-circle-exclamation' : 'fa-circle-check text-emerald-400';

            toast.className = `${bgColor} text-white px-4 py-3 rounded-xl shadow-xl text-sm font-bold flex items-center gap-2.5 transition-all duration-300 transform translate-y-2 opacity-0`;
            toast.innerHTML = `<i class="fa-solid ${icon}"></i><span>${message}</span>`;
            container.appendChild(toast);

            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            });

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3200);
        }

        // Security: XSS Prevention
        function escapeHTML(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        // Start Cloud App
        window.addEventListener('DOMContentLoaded', initCloudApp);
    </script>
</body>
</html>
